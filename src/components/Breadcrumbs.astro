---
interface Props {
  trail: { label: string; href?: string }[];
}
const { trail } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {
      trail.map((c) => (
        <li>
          {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.45rem;
    color: var(--border-strong);
  }

  .crumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .crumbs span {
    color: var(--text);
    font-weight: 550;
  }
</style>
