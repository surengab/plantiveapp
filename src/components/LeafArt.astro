---
/**
 * Lightweight generated card art. Each guide gets a tinted ground plus a
 * silhouette matching its foliage shape, so the index looks illustrated without
 * shipping a single photograph.
 *
 * Shapes are composed from primitives (ellipses, rotated copies) rather than
 * hand-authored bezier paths — easier to reason about and they render cleanly
 * at every size.
 */
interface Props {
  silhouette:
    | 'monstera'
    | 'heart'
    | 'lance'
    | 'round'
    | 'spiky'
    | 'trailing'
    | 'frond'
    | 'rosette';
  hue?: number;
  class?: string;
}

const { silhouette, hue = 140, class: className = '' } = Astro.props;

const stem = (d: string, w = 3) =>
  `<path d="${d}" fill="none" stroke="currentColor" stroke-width="${w}" stroke-linecap="round"/>`;

/** Lobes mirrored either side of a central midrib — the split-leaf look. */
const lobes = (rows: [cy: number, dx: number, rx: number, ry: number, rot: number][]) =>
  rows
    .flatMap(([cy, dx, rx, ry, rot]) => [
      `<ellipse cx="${50 - dx}" cy="${cy}" rx="${rx}" ry="${ry}" transform="rotate(${-rot} ${50 - dx} ${cy})"/>`,
      `<ellipse cx="${50 + dx}" cy="${cy}" rx="${rx}" ry="${ry}" transform="rotate(${rot} ${50 + dx} ${cy})"/>`,
    ])
    .join('');

/** Petals radiating from the centre, for rosette succulents. */
const rosettePetals = (count: number, cy: number, rx: number, ry: number) =>
  Array.from(
    { length: count },
    (_, i) =>
      `<ellipse cx="50" cy="${cy}" rx="${rx}" ry="${ry}" transform="rotate(${(360 / count) * i} 50 50)"/>`
  ).join('');

/** Tapered blades fanning from a common base, for aloes and snake plants. */
const blades = (angles: number[], baseY: number, tipY: number, halfWidth: number) =>
  angles
    .map(
      (a) =>
        `<path d="M50 ${baseY} L${50 - halfWidth} ${(baseY + tipY) / 2} L50 ${tipY} L${50 + halfWidth} ${(baseY + tipY) / 2} Z" transform="rotate(${a} 50 ${baseY})"/>`
    )
    .join('');

/**
 * Monstera: one broad leaf with slits masked out of the margins, which is how
 * fenestration actually looks — rather than separate lobes on a stalk.
 */
const monsteraCuts = [
  [30, -26],
  [50, -4],
  [70, 17],
]
  .flatMap(([cy, rot]) => [
    `<ellipse cx="76" cy="${cy}" rx="27" ry="4.6" transform="rotate(${rot} 76 ${cy})" fill="#000"/>`,
    `<ellipse cx="24" cy="${cy}" rx="27" ry="4.6" transform="rotate(${-rot} 24 ${cy})" fill="#000"/>`,
  ])
  .join('');

const shapes: Record<Props['silhouette'], string> = {
  monstera:
    `<defs><mask id="la-monstera">` +
    `<ellipse cx="50" cy="46" rx="35" ry="40" fill="#fff"/>` +
    monsteraCuts +
    // Painted back over the cuts so the midrib stays continuous, as it does on
    // a real leaf — otherwise the slits sever the blade into floating bands.
    `<ellipse cx="50" cy="46" rx="5" ry="40" fill="#fff"/>` +
    `</mask></defs>` +
    stem('M50 99V80') +
    `<ellipse cx="50" cy="46" rx="35" ry="40" mask="url(#la-monstera)"/>`,

  // Heart-shaped: philodendron and pothos foliage.
  heart:
    `<path d="M50 94C31 80 13 63 13 43 13 27 25 15 39 15c6 0 9 3 11 7 2-4 5-7 11-7 14 0 24 12 24 28 0 20-18 37-35 51Z"/>` +
    `<path class="vein" d="M50 88V30" fill="none" stroke-width="2.4" stroke-linecap="round"/>`,

  // Upright strap leaves: snake plant, dracaena.
  lance: blades([-16, 0, 16], 96, 8, 11),

  // Broad round leaf: rubber plant, fiddle leaf fig, peperomia.
  round:
    stem('M50 97V78') +
    `<ellipse cx="50" cy="47" rx="33" ry="38"/>` +
    `<g class="vein" fill="none" stroke-width="2.2" stroke-linecap="round">` +
    `<path d="M50 80V16"/><path d="M50 40 68 26"/><path d="M50 40 32 26"/><path d="M50 58 72 46"/><path d="M50 58 28 46"/>` +
    `</g>`,

  // Fleshy spikes fanning from a base: aloe, haworthia.
  spiky: blades([-44, -22, 0, 22, 44], 94, 12, 9),

  // Trailing vine with round leaves: string of pearls, ivy.
  trailing:
    stem('M30 8C42 28 22 42 36 60 48 76 36 86 46 97', 3) +
    `<circle cx="30" cy="10" r="6"/><circle cx="37" cy="26" r="6.5"/><circle cx="27" cy="42" r="6.5"/>` +
    `<circle cx="38" cy="59" r="7"/><circle cx="42" cy="77" r="6.5"/><circle cx="46" cy="94" r="5.5"/>`,

  // Feathered frond: fern, palm.
  frond:
    stem('M50 98V8') +
    lobes([
      [22, 11, 11, 5, 40],
      [40, 13, 14, 5.5, 30],
      [58, 14, 15, 6, 22],
      [76, 12, 12, 5.5, 14],
    ]),

  // Tight rosette: echeveria, succulents.
  rosette:
    rosettePetals(9, 26, 8.5, 17) +
    rosettePetals(6, 38, 6, 11) +
    `<circle cx="50" cy="50" r="5.5"/>`,
};

const inner = shapes[silhouette];
---

<div class={`leaf-art ${className}`} style={`--h:${hue}`} aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" set:html={inner} />
</div>

<style>
  .leaf-art {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
    background: linear-gradient(
      145deg,
      hsl(var(--h) 42% 92%) 0%,
      hsl(calc(var(--h) + 22) 38% 84%) 100%
    );
    display: grid;
    place-items: center;
  }

  .leaf-art svg {
    width: 62%;
    height: 78%;
    transform: rotate(-7deg);
    fill: hsl(var(--h) 40% 34%);
    color: hsl(var(--h) 40% 34%);
    filter: drop-shadow(0 4px 10px hsl(var(--h) 35% 30% / 0.2));
  }

  /* Midribs and veins read as a lighter tracery cut into the leaf body. */
  .leaf-art :global(.vein) {
    stroke: hsl(var(--h) 42% 92%);
    opacity: 0.5;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .leaf-art {
      background: linear-gradient(
        145deg,
        hsl(var(--h) 28% 18%) 0%,
        hsl(calc(var(--h) + 22) 26% 13%) 100%
      );
    }
    :global(:root:not([data-theme='light'])) .leaf-art svg {
      fill: hsl(var(--h) 38% 60%);
      color: hsl(var(--h) 38% 60%);
    }
    :global(:root:not([data-theme='light'])) .leaf-art :global(.vein) {
      stroke: hsl(var(--h) 28% 16%);
      opacity: 0.65;
    }
  }

  :global(:root[data-theme='dark']) .leaf-art {
    background: linear-gradient(
      145deg,
      hsl(var(--h) 28% 18%) 0%,
      hsl(calc(var(--h) + 22) 26% 13%) 100%
    );
  }
  :global(:root[data-theme='dark']) .leaf-art svg {
    fill: hsl(var(--h) 38% 60%);
    color: hsl(var(--h) 38% 60%);
  }
  :global(:root[data-theme='dark']) .leaf-art :global(.vein) {
    stroke: hsl(var(--h) 28% 16%);
    opacity: 0.65;
  }
</style>
