---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbs, itemList } from '../../lib/schema';

const guides = (await getCollection('guides', (guide) => !guide.data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const title = 'Practical Houseplant Guides and Care Checklists';
const description =
  'Straightforward houseplant guides for weekly care, new plants, clean leaves, fertilising, humidity and keeping plants healthy while you travel.';
const trail = [{ label: 'Guides', href: '/guides/' }];

const schema = [
  breadcrumbs(trail),
  itemList(
    '/guides/',
    'Practical houseplant guides',
    guides.map((guide) => ({ name: guide.data.title, href: `/guides/${guide.id}/` }))
  ),
];
---

<Base title={title} description={description} canonical="/guides/" schema={schema}>
  <div class="wrap hub-head">
    <Breadcrumbs trail={trail} />
    <p class="eyebrow">Practical plant care</p>
    <h1>Guides you can use today</h1>
    <p class="lede">
      Short, step-by-step help for the jobs around watering: settling in a new plant, building a
      weekly routine, cleaning leaves, feeding responsibly, managing humidity and planning a trip.
    </p>
  </div>

  <section class="wrap section-tight" aria-labelledby="all-guides">
    <h2 id="all-guides">All practical guides</h2>
    <div class="grid grid-3 guide-grid">
      {
        guides.map((guide) => (
          <a class="card guide" href={`/guides/${guide.id}/`}>
            <span class="pill pill-outline">{guide.data.category}</span>
            <h3>{guide.data.title}</h3>
            <p>{guide.data.excerpt}</p>
            <span class="meta">
              {guide.data.readingTime ? `${guide.data.readingTime} min read` : 'Quick guide'}
            </span>
            <span class="read-more">Read guide →</span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="wrap">
    <CtaBand
      source="guides-hub"
      heading="Need advice for a specific plant?"
      body="Identify it with Plantive, then match the species to its watering, light and troubleshooting guidance."
    />
  </div>
</Base>

<style>
  .hub-head {
    padding-top: 2.25rem;
  }

  .hub-head .eyebrow {
    margin-top: 1.2rem;
  }

  .hub-head h1 {
    margin-block: 0.4rem 0.9rem;
  }

  section > h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }

  .guide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .guide h3 {
    font-size: 1.18rem;
    line-height: 1.3;
  }

  .guide p {
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    flex: 1;
  }

  .meta {
    color: var(--text-muted);
    font-size: 0.8rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border);
    width: 100%;
  }

  .read-more {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
  }
</style>
