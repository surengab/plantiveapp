---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbs, itemList } from '../../lib/schema';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const [lead, ...rest] = posts;

const title = 'Plant Care Blog: Watering, Light and Growing Advice';
const description =
  'Practical houseplant advice that goes past the label: how to water properly, measure light at home, repot, pick pet-safe plants and identify from photos.';

const trail = [{ label: 'Blog', href: '/blog/' }];

const schema = [
  breadcrumbs(trail),
  itemList(
    '/blog/',
    'Plantive plant care articles',
    posts.map((p) => ({ name: p.data.title, href: `/blog/${p.id}/` }))
  ),
];

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title={title} description={description} canonical="/blog/" schema={schema}>
  <div class="wrap hub-head">
    <Breadcrumbs trail={trail} />
    <h1>The Plantive Blog</h1>
    <p class="lede">
      The fundamentals that determine whether a houseplant thrives or slowly declines: watering,
      light, soil and choosing plants that match the home you actually have.
    </p>
  </div>

  {
    lead && (
      <section class="wrap section-tight">
        <a class="card lead" href={`/blog/${lead.id}/`}>
          <div class="lead-body">
            <div class="meta">
              <span class="pill">{lead.data.category}</span>
              <span class="date">{fmt(lead.data.publishDate)}</span>
              {lead.data.readingTime && <span class="date">{lead.data.readingTime} min read</span>}
            </div>
            <h2>{lead.data.title}</h2>
            <p>{lead.data.excerpt}</p>
            <span class="read-more">Read article →</span>
          </div>
        </a>
      </section>
    )
  }

  <section class="wrap section-tight">
    <div class="grid grid-3">
      {
        rest.map((post) => (
          <a class="card post" href={`/blog/${post.id}/`}>
            <div class="meta">
              <span class="pill pill-outline">{post.data.category}</span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.excerpt}</p>
            <span class="foot">
              {fmt(post.data.publishDate)}
              {post.data.readingTime && ` · ${post.data.readingTime} min`}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="wrap">
    <CtaBand source="blog-hub" />
  </div>
</Base>

<style>
  .hub-head {
    padding-top: 2.25rem;
  }

  .hub-head h1 {
    margin-block: 1rem 0.9rem;
  }

  .lead {
    padding: 0;
    overflow: hidden;
    background: linear-gradient(135deg, var(--accent-soft), var(--bg-raised));
    border-color: var(--green-300);
  }

  .lead-body {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .lead h2 {
    font-size: var(--step-3);
    margin-block: 0.9rem 0.6rem;
    max-width: 22ch;
  }

  .lead p {
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 58ch;
    margin-bottom: 1rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .date {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .read-more {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--accent);
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .post h2 {
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .post p {
    color: var(--text-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    flex: 1;
  }

  .foot {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
</style>
