---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { APP } from '../consts';
import { breadcrumbs } from '../lib/schema';

const trail = [{ label: 'Support', href: '/support/' }];
---

<Base
  title="Plantive Support — Contact, Subscriptions and Refunds"
  description="Get help with the Plantive app: contact support, manage or cancel a subscription, request a refund, and report a bug or an incorrect identification."
  canonical="/support/"
  schema={[breadcrumbs(trail)]}
>
  <div class="wrap hub-head">
    <Breadcrumbs trail={trail} />
    <h1>Support</h1>
    <p class="lede">
      Email <a href={`mailto:${APP.supportEmail}`}>{APP.supportEmail}</a> and we will get back to
      you. Most of the common questions are answered below.
    </p>
  </div>

  <div class="wrap">
    <div class="grid grid-2 cards">
      <div class="card sup">
        <h2>Contact us</h2>
        <p>
          Email <a href={`mailto:${APP.supportEmail}`}>{APP.supportEmail}</a>. For technical
          problems, include your iPhone model and iOS version — that usually lets us resolve things
          in one exchange instead of several.
        </p>
      </div>

      <div class="card sup">
        <h2>Cancel a subscription</h2>
        <p>
          Subscriptions are managed by Apple, not by us. On your iPhone open <strong>Settings</strong>,
          tap your name, then <strong>Subscriptions</strong>, select Plantive and choose
          <strong>Cancel Subscription</strong>. Cancelling takes effect at the end of the current
          billing period.
        </p>
      </div>

      <div class="card sup">
        <h2>Request a refund</h2>
        <p>
          App Store refunds are handled by Apple. Visit
          <a href="https://reportaproblem.apple.com" rel="noopener" target="_blank"
            >reportaproblem.apple.com</a
          >, sign in with your Apple ID, find the purchase and request a refund. We cannot issue App
          Store refunds directly, but do get in touch if something went wrong.
        </p>
      </div>

      <div class="card sup">
        <h2>Restore purchases</h2>
        <p>
          If you reinstalled the app or changed device, open Plantive, go to the Pro tab and tap
          <strong>Restore Purchases</strong>. Make sure you are signed in with the same Apple ID used
          for the original purchase.
        </p>
      </div>

      <div class="card sup">
        <h2>Report a wrong identification</h2>
        <p>
          Send the photo and what you believe the plant is to
          <a href={`mailto:${APP.supportEmail}`}>{APP.supportEmail}</a>. Identification accuracy
          depends heavily on the photo — a close, well-lit shot of a single leaf or flower against a
          plain background works far better than a wide shot of several plants.
        </p>
      </div>

      <div class="card sup">
        <h2>Report an error in a guide</h2>
        <p>
          If something in a care guide is wrong or out of date, email
          <a href={`mailto:${APP.supportEmail}`}>{APP.supportEmail}</a> with the page and what is
          incorrect. We would much rather fix it than leave it. Every guide shows its last review
          date at the foot of the page.
        </p>
      </div>
    </div>

    <div class="card notice">
      <h2>If a pet or child has eaten a plant</h2>
      <p>
        Contact your vet, a poison control line, or emergency services <strong>immediately</strong>.
        Do not wait for symptoms and do not spend time identifying the plant first — take it with you
        or send a photo, and let them identify it while treatment begins.
      </p>
      <p>
        This is especially urgent for cats and true lilies (<em>Lilium</em> and <em>Hemerocallis</em>),
        which cause kidney failure from very small exposures, and for sago palm in both cats and dogs.
      </p>
    </div>

    <div class="legal">
      <p>
        <a href={APP.privacyUrl} rel="noopener" target="_blank">Privacy policy</a> ·
        <a href={APP.termsUrl} rel="noopener" target="_blank">Terms of use</a> ·
        <a href="/faq/">FAQ</a>
      </p>
      <p class="dev">Plantive is published by {APP.developer}.</p>
    </div>
  </div>
</Base>

<style>
  .hub-head {
    padding-top: 2.25rem;
  }

  .hub-head h1 {
    margin-block: 1rem 0.9rem;
  }

  .cards {
    margin-top: 1rem;
  }

  .sup h2 {
    font-size: 1.15rem;
    margin-bottom: 0.55rem;
  }

  .sup p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .notice {
    margin-top: 1.25rem;
    border-color: var(--rose-500);
    background: var(--rose-100);
  }

  .notice h2 {
    font-size: 1.15rem;
    margin-bottom: 0.55rem;
    color: var(--rose-500);
  }

  .notice p + p {
    margin-top: 0.7rem;
  }

  .notice p {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .dev {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
