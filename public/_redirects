# Cloudflare Pages redirect rules.
# Consolidates www onto the apex so Google indexes one hostname, matching the
# canonical URLs and the sitemap. Requires www.plantiveapp.com to be attached to
# the Pages project as a custom domain; otherwise do it with a Cloudflare
# Redirect Rule instead.

https://www.plantiveapp.com/*  https://plantiveapp.com/:splat  301

# Cloudflare Pages strips .html extensions and 308-redirects to the bare path.
# Google Search Console requires its verification file to return 200 at the
# exact URL it was given, so rewrite (200) instead of letting Pages redirect.
/googled3a3104e21d45d9e.html  /googled3a3104e21d45d9e  200
